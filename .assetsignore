# Repo furniture that must not be served from martymcenroe.ai.
# GitHub Pages served CLAUDE.md and README.md publicly (both returned 200); that
# stops here.
**/.git
**/.github
**/.DS_Store
**/node_modules

# Wrangler's own scratch dir. The assets directory is the repo root, so wrangler
# writes its temp files INSIDE the thing it is about to publish. The first deploy
# put /.wrangler/tmp/deploy-*/no-op-worker.js on the public site, serving 200.
**/.wrangler

# Operational scripts and session artifacts. Gitignored, which meant nothing here:
# .gitignore governs git, .assetsignore governs what gets published, and the assets
# directory is the repo root. The cutover and migration scripts carry zone and DNS
# record identifiers and have no business on a public site.
**/data
.gitignore
.unleashed.json
.assetsignore
wrangler.jsonc
CLAUDE.md
README.md

# Kept in the repo so a rollback to GitHub Pages still works, but not published.
CNAME

# resume.docx still carries the old maroon scheme and cannot be regenerated from
# this repo, so it now contradicts resume.html and resume.pdf. Nothing links to it;
# index.html links the pdf. Kept in the repo, no longer reachable on the site, so a
# recruiter cannot stumble onto an off-brand copy of the resume. Delete this line if
# you want it published again.
resume.docx
